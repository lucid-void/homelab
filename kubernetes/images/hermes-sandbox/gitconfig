# System git config for the Hermes sandbox. Credentials come from the
# read-only file mounted from the sandbox SealedSecret; the agent's own
# ~/.gitconfig (on the PVC) can still override identity or add helpers.
[credential]
	helper = store --file=/etc/hermes-sandbox/git/credentials
[user]
	name = hermes
	email = hermes@hermes.invalid
[init]
	defaultBranch = main
[push]
	default = current
[safe]
	directory = *
