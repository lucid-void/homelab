[Unit]
Description=Blocky DNS resolver and ad blocker
Documentation=https://github.com/lucid-void/Homelab/blob/main/design/decisions/dns.md
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/opt/blocky/current/blocky --config /etc/blocky/config.yml
Restart=always
RestartSec=5
User=blocky
Group=blocky
# Creates /var/cache/blocky/lists, the blocklist cache named in the config.
CacheDirectory=blocky/lists
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# This Pi also runs the UPS shutdown. DNS must never be able to starve it.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
