{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./recovery.key)",
      "Read(./**/*-secret.yml)",
      "Read(./kubernetes/flux/vars/cluster-secrets.yml)",
      "Read(./infra/terraform/terraform.tfstate*)",
      "Read(./kubernetes/talos/clusterconfig/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/inject-context.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-manifests.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
