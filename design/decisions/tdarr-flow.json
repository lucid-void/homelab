{
  "_id": "h264-to-hevc-slow",
  "name": "H.264 to HEVC (x265 slow, CRF 21, verified swap)",
  "description": "720p/1080p H.264 at 6 Mbps and up -> x265 slow CRF 21 10-bit mkv, staged, verified and swapped by /scripts/tdarr-swap.sh. See design/decisions/tdarr.md.",
  "tags": "",
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "id": "in",
      "position": {
        "x": 400,
        "y": 0
      }
    },
    {
      "name": "Is H.264",
      "sourceRepo": "Community",
      "pluginName": "checkVideoCodec",
      "version": "1.0.0",
      "id": "codec",
      "position": {
        "x": 400,
        "y": 100
      },
      "inputsDB": {
        "codec": "h264"
      }
    },
    {
      "name": "Resolution",
      "sourceRepo": "Community",
      "pluginName": "checkVideoResolution",
      "version": "1.0.0",
      "id": "res",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "name": "Video bitrate 6 Mbps and up (with fallbacks)",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "id": "br",
      "position": {
        "x": 400,
        "y": 300
      },
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  // Video bitrate >= 6 Mbps -> output 1 (encode), else output 2 (skip).\n  // mkv files muxed without stream statistics have no per-stream bitrate, so\n  // fall back to the container bitrate minus audio. Unknown -> skip, never fail.\n  const MIN = 6000000;\n  const f = args.inputFileObj || {};\n  const num = (x) => { const n = Number(x); return Number.isFinite(n) && n > 0 ? n : 0; };\n  const tagBps = (s) => num(s && s.tags && (s.tags.BPS || s.tags['BPS-eng']));\n  const mi = (f.mediaInfo && f.mediaInfo.track) || [];\n  const probe = f.ffProbeData || {};\n  const streams = probe.streams || [];\n  const fmt = probe.format || {};\n  const miVideo = mi.find((t) => String(t['@type']).toLowerCase() === 'video');\n  const fpVideo = streams.find((s) => s.codec_type === 'video');\n  let v = num(miVideo && miVideo.BitRate);\n  let how = 'mediainfo video stream';\n  if (!v) { v = num(fpVideo && fpVideo.bit_rate) || tagBps(fpVideo); how = 'ffprobe video stream'; }\n  if (!v) {\n    let total = num(fmt.bit_rate) || num(f.bit_rate);\n    const dur = num(fmt.duration) || num(f.duration);\n    if (!total && dur) total = (num(fmt.size) || num(f.file_size) * 1048576) * 8 / dur; // file_size is MiB\n    let audio = 0;\n    streams.filter((s) => s.codec_type === 'audio').forEach((s) => { audio += num(s.bit_rate) || tagBps(s); });\n    if (!audio) mi.filter((t) => String(t['@type']).toLowerCase() === 'audio').forEach((t) => { audio += num(t.BitRate); });\n    v = total > audio ? total - audio : 0;\n    how = `container ${Math.round(total / 1000)} kbps minus audio ${Math.round(audio / 1000)} kbps`;\n  }\n  const out = v >= MIN ? 1 : 2;\n  args.jobLog(`Video bitrate ${Math.round(v / 1000)} kbps (${how}): ${out === 1 ? 'encode' : 'skip, under 6 Mbps or unknown'}`);\n  return { outputFileObj: f, outputNumber: out, variables: args.variables };\n};\n"
      }
    },
    {
      "name": "Begin Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "id": "start",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "name": "Set 10 Bit Video",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommand10BitVideo",
      "version": "1.0.0",
      "id": "b10",
      "position": {
        "x": 400,
        "y": 500
      }
    },
    {
      "name": "Set Video Encoder x265",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetVideoEncoder",
      "version": "1.0.0",
      "id": "enc",
      "position": {
        "x": 400,
        "y": 600
      },
      "inputsDB": {
        "outputCodec": "hevc",
        "ffmpegPresetEnabled": "true",
        "ffmpegPreset": "slow",
        "ffmpegQualityEnabled": "true",
        "ffmpegQuality": "21",
        "hardwareEncoding": "false",
        "hardwareType": "auto",
        "hardwareDecoding": "false",
        "forceEncoding": "true"
      }
    },
    {
      "name": "Cap x265 threads",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "args",
      "position": {
        "x": 400,
        "y": 700
      },
      "inputsDB": {
        "inputArguments": "",
        "outputArguments": "-x265-params pools=6:log-level=error -tag:v hvc1"
      }
    },
    {
      "name": "Execute",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "id": "exec",
      "position": {
        "x": 400,
        "y": 900
      }
    },
    {
      "name": "Stage next to the library",
      "sourceRepo": "Community",
      "pluginName": "copyToDirectory",
      "version": "1.0.0",
      "id": "stage",
      "position": {
        "x": 400,
        "y": 1000
      },
      "inputsDB": {
        "outputDirectory": "/Media/.tdarr-staging",
        "keepRelativePath": "true",
        "makeWorkingFile": "true"
      }
    },
    {
      "name": "Verify and swap; the swapped file becomes the working file",
      "sourceRepo": "Community",
      "pluginName": "runCli",
      "version": "1.0.0",
      "id": "swap",
      "position": {
        "x": 400,
        "y": 1100
      },
      "inputsDB": {
        "useCustomCliPath": "true",
        "customCliPath": "/scripts/tdarr-swap.sh",
        "doesCommandCreateOutputFile": "true",
        "cliArguments": "\"{{{args.originalLibraryFile._id}}}\" \"{{{args.inputFileObj._id}}}\"",
        "outputFileBecomesWorkingFile": "true",
        "userOutputFilePath": "{{{args.originalLibraryFile._id}}}"
      }
    }
  ],
  "flowEdges": [
    {
      "source": "in",
      "sourceHandle": "1",
      "target": "codec",
      "targetHandle": null,
      "id": "in-1-codec"
    },
    {
      "source": "codec",
      "sourceHandle": "1",
      "target": "res",
      "targetHandle": null,
      "id": "codec-1-res"
    },
    {
      "source": "res",
      "sourceHandle": "3",
      "target": "br",
      "targetHandle": null,
      "id": "res-3-br"
    },
    {
      "source": "res",
      "sourceHandle": "4",
      "target": "br",
      "targetHandle": null,
      "id": "res-4-br"
    },
    {
      "source": "br",
      "sourceHandle": "1",
      "target": "start",
      "targetHandle": null,
      "id": "br-1-start"
    },
    {
      "source": "start",
      "sourceHandle": "1",
      "target": "b10",
      "targetHandle": null,
      "id": "start-1-b10"
    },
    {
      "source": "b10",
      "sourceHandle": "1",
      "target": "enc",
      "targetHandle": null,
      "id": "b10-1-enc"
    },
    {
      "source": "enc",
      "sourceHandle": "1",
      "target": "args",
      "targetHandle": null,
      "id": "enc-1-args"
    },
    {
      "source": "exec",
      "sourceHandle": "1",
      "target": "stage",
      "targetHandle": null,
      "id": "exec-1-stage"
    },
    {
      "source": "stage",
      "sourceHandle": "1",
      "target": "swap",
      "targetHandle": null,
      "id": "stage-1-swap"
    },
    {
      "source": "args",
      "sourceHandle": "1",
      "target": "exec",
      "targetHandle": null,
      "id": "args-exec"
    }
  ]
}
